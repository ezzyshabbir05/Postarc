# -----------------------------------------------------------------------------
# Postarc Self-Hosting Configuration
# -----------------------------------------------------------------------------

# Primary Mail Server Domain (e.g. mail.yourdomain.com)
HOSTNAME=mail.example.com

# Initial SuperAdmin Credentials
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=ChangeMe#AdminSecret2026

# PostgreSQL Database Configuration
DB_NAME=postarc
DB_USER=postarc
DB_PASSWORD=postarc_super_secure_db_pass_2026

# Web UI & Session Encryption
SESSION_SECRET=postarc_session_encryption_key_at_least_32_chars_long

# Node & Engine Environment
NODE_ENV=production
POSTARC_LOG_LEVEL=info

